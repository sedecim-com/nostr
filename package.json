{
  "name": "sedecim-nostr",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma Nostr soberana / SaaS: SDK, servicios y clientes interoperables con grados configurables de soberan\u00eda.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "keygen": "tsx apps/key-generator/src/cli.ts",
    "sovereign": "tsx apps/sovereign-client/src/cli.ts",
    "dev:relay": "tsx packages/test-relay/src/cli.ts",
    "build:web": "node apps/web-saas/build.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json",
    "test:browser": "npm run build:web && tsx tests/browser/web-saas.e2e.ts",
    "test:interop": "vitest run tests/interop",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://sedecim:sedecim@127.0.0.1:5432/sedecim_test} vitest run services"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "nostr-tools": "2.25.2",
    "playwright": "^1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
