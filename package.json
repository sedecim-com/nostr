{
  "name": "sedecim-nostr",
  "private": true,
  "version": "0.1.0",
  "description": "Acceso Nostr: plataforma Nostr soberana / SaaS con SDK, servicios y clientes interoperables y grados configurables de soberanía.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "keygen": "tsx apps/key-generator/src/cli.ts",
    "build:keygen-html": "node apps/key-generator/build-html.mjs",
    "test:keygen-html": "tsx tests/browser/keygen-html.e2e.ts",
    "lint:claims": "tsx scripts/lint-claims.ts",
    "sovereign": "tsx apps/sovereign-client/src/cli.ts",
    "dev:relay": "tsx packages/test-relay/src/cli.ts",
    "build:web": "vite build --config apps/web-saas/vite.config.ts",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json",
    "test:browser": "npm run build:web && tsx tests/browser/web-saas.e2e.ts && tsx tests/browser/web-leaks.e2e.ts",
    "test:leak": "bash scripts/leak-test.sh",
    "test:interop": "vitest run tests/interop",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://sedecim:sedecim@127.0.0.1:5432/sedecim_test} vitest run services",
    "backlog": "node scripts/backlog.mjs",
    "dev:web": "vite --config apps/web-saas/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react-swc": "3.11.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "nostr-tools": "2.25.2",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "ts-mls": "2.0.0-rc.16"
  }
}
