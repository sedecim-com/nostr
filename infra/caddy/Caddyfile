# Production TLS front for the self-hosted stack (compose.tls.yml). Certificates via ACME.
# Each service gets its own subdomain so Nostr relays keep a clean WebSocket origin (NIP-42 relay tag).
# Rate limits: the stock Caddy image has no limiter module; the services apply their own per-address and
# per-principal buckets (RATE_LIMIT_*, compose.tls.yml trusts this proxy's X-Forwarded-For).
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

{$DOMAIN} {
	import security_headers
	reverse_proxy web:8080
}

relay.{$DOMAIN} {
	import security_headers
	reverse_proxy relay:3000
}

secure.{$DOMAIN} {
	import security_headers
	reverse_proxy secure-relay:8080
}

blobs.{$DOMAIN} {
	import security_headers
	request_body {
		max_size 50MB
	}
	reverse_proxy blob-store:8085
}

mirror.{$DOMAIN} {
	import security_headers
	reverse_proxy indexer:8081
}

id.{$DOMAIN} {
	import security_headers
	reverse_proxy identity-service:8082
}

policy.{$DOMAIN} {
	import security_headers
	reverse_proxy policy-engine:8083
}

# Continuity Vault (VAULT-06): one sealed envelope per request, 1 MiB by default (VAULT_MAX_ENVELOPE_BYTES).
vault.{$DOMAIN} {
	import security_headers
	request_body {
		max_size 2MB
	}
	reverse_proxy continuity-vault:8088
}
