# Copy to .env and replace every CHANGE_ME, or run scripts/init-env.sh: it fills every CHANGE_ME/empty key
# below (random secrets; Nostr keys with the offline key generator after 'npm ci') and never overwrites a value.
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# 64 hex chars. Relay signing key (relay-signed NIP-29 events). Keep stable and backed up.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME
# Relay owner pubkey (64 hex). init-env.sh generates it and writes the secret ONLY to an encrypted NIP-49
# backup (.data/relay-owner.ncryptsec.json, password asked or OWNER_PASSWORD_FILE). Or set your own pubkey.
RELAY_OWNER_PUBKEY=
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME
# Public relay URL used for NIP-42 relay tag checks.
RELAY_URL=ws://localhost:3000
BUZZ_MEDIA_BASE_URL=http://localhost:3000/media
WEB_ORIGIN=http://localhost:8080
# Set true + insert pubkeys to restrict NIP-42 logins (see docs/buzz-integration.md).
BUZZ_PUBKEY_ALLOWLIST=false

# Mirror (indexer) NIP-42 identity: nsec or 64 hex. Generated by scripts/init-env.sh.
INDEXER_NSEC=CHANGE_ME
# Optional: seal the mirror's raw events at rest (64 hex chars).
MIRROR_AT_REST_KEY=
# Institutional mode: comma separated admin pubkeys (hex) and service tokens (token:principal).
POLICY_ADMIN_PUBKEYS=
POLICY_SERVICE_TOKENS=

# --profile managed (CUSTODIAL). KEK: 64 hex chars from your KMS/HSM; tokens: token:principal
MANAGED_SIGNER_KEK=
MANAGED_SIGNER_TOKENS=

# Encrypted attachments store: restrict uploads to these pubkeys (comma separated hex). Empty = any NIP-authenticated pubkey.
BLOB_ALLOWED_PUBKEYS=

# Secondary relay (Marmot/MLS groups, Tor personas). Edit infra/secure-relay/config.toml relay_url to its public URL.
SECURE_RELAY_PORT=7000
