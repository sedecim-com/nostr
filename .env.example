# Copy to .env and replace every CHANGE_ME, or run scripts/init-env.sh: it fills every CHANGE_ME/empty key
# below (random secrets; Nostr keys with the offline key generator after 'npm ci') and never overwrites a value.
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Continuity Vault (VAULT-06): its own SeaweedFS keys, which reach only its bucket.
VAULT_S3_ACCESS_KEY=CHANGE_ME
VAULT_S3_SECRET_KEY=CHANGE_ME
# 64 hex chars. Relay signing key (relay-signed NIP-29 events). Keep stable and backed up.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME
# Relay owner pubkey (64 hex). init-env.sh generates it and writes the secret ONLY to an encrypted NIP-49
# backup (.data/relay-owner.ncryptsec.json, password asked or OWNER_PASSWORD_FILE). Or set your own pubkey.
RELAY_OWNER_PUBKEY=
# Buzz operators (hex, comma-separated): can create communities, e.g. for the relay .onion host
# (scripts/buzz-provision-community.ts). Empty disables provisioning.
RELAY_OPERATOR_PUBKEYS=
# Origin the operators sign NIP-98 for (the relay HTTP URL they call, e.g. http://localhost:3000).
RELAY_OPERATOR_API_ORIGIN=
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME
# Public relay URL used for NIP-42 relay tag checks.
RELAY_URL=ws://localhost:3000
BUZZ_MEDIA_BASE_URL=http://localhost:3000/media
WEB_ORIGIN=http://localhost:8080
# Set true + insert pubkeys to restrict NIP-42 logins (see docs/buzz-integration.md).
BUZZ_PUBKEY_ALLOWLIST=false

# Mirror (indexer) NIP-42 identity: nsec or 64 hex. Generated by scripts/init-env.sh.
INDEXER_NSEC=CHANGE_ME
# Optional: seal the mirror's raw events at rest (64 hex chars), each bound to its event id (SEC-06).
MIRROR_AT_REST_KEY=
# Institutional mode (docs/institutional.md): comma separated admin pubkeys (hex) and service tokens (token:principal).
POLICY_ADMIN_PUBKEYS=
POLICY_SERVICE_TOKENS=
# Indexer: reads evaluated by the policy-engine + retention (token must be in POLICY_SERVICE_TOKENS). Empty URL = off.
INDEXER_POLICY_ENGINE_URL=
INDEXER_POLICY_ENGINE_TOKEN=
# --profile institutional: relay allowlist sync (token in POLICY_SERVICE_TOKENS; also set BUZZ_PUBKEY_ALLOWLIST=true
# and SECURE_RELAY_CONFIG=./infra/secure-relay/config.institutional.toml). Service pubkeys (hex) always allowed.
RELAY_ALLOWLIST_POLICY_TOKEN=
ALLOWLIST_EXTRA_PUBKEYS=
# Device passkeys (WebAuthn): RP id defaults to the WEB_ORIGIN host; true rejects passkeys without attestation.
WEBAUTHN_RP_ID=
WEBAUTHN_REQUIRE_ATTESTATION=false
# Days the policy-engine keeps its access decisions (resources under legal hold excepted).
POLICY_ACCESS_LOG_RETENTION_DAYS=90

# --profile managed (CUSTODIAL). Needs the Acceso pool (COGNITO_*) and/or legacy service tokens.
# Vault: local (KEK = 64 hex chars from your KMS/HSM) or aws (Secrets Manager + KMS key, region us-east-1).
MANAGED_SIGNER_VAULT=local
MANAGED_SIGNER_KEK=
MANAGED_SIGNER_KMS_KEY_ID=
MANAGED_SIGNER_SECRET_PREFIX=acceso-nostr/managed-keys/
AWS_REGION=us-east-1
# Only where no IAM role is available (e.g. self-hosted outside AWS).
MANAGED_SIGNER_AWS_ACCESS_KEY_ID=
MANAGED_SIGNER_AWS_SECRET_ACCESS_KEY=
# Test endpoint only (moto/LocalStack); leave empty in production.
MANAGED_SIGNER_AWS_ENDPOINT=
# DEC-09: days before a deleted key's material is destroyed; months the usage log is kept.
MANAGED_SIGNER_RETENTION_DAYS=30
MANAGED_SIGNER_USAGE_RETENTION_MONTHS=12
# Acceso (Cognito) pool shared with identity-service (ADR 0008). Empty in self-hosted; the managed signer
# (profile managed) requires it: users sign with their Acceso token or a device session (FR005-12).
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# FR024-03: token:principal allowed to revoke devices (POST /v1/devices/:id/revoke), e.g. the rotation worker.
MANAGED_SIGNER_REVOCATION_TOKENS=
# true: key operations only through device-bound sessions (a stolen device's sessions die with its revocation).
MANAGED_SIGNER_REQUIRE_DEVICE_SESSION=false
# FR005-06: signing limits per minute, per key and per kind of a key; overrides as kind:perMin[:burst],...
MANAGED_SIGNER_RATE_PER_KEY=120
MANAGED_SIGNER_RATE_PER_KIND=60
MANAGED_SIGNER_RATE_KINDS=

# Encrypted attachments store: restrict uploads to these pubkeys (comma separated hex). Empty = any NIP-authenticated pubkey.
BLOB_ALLOWED_PUBKEYS=

# Continuity Vault (ADR 0011): public URL (the web's "continuityVault" in infra/web/config.json), who may open an
# account (open: any Nostr key, each account within VAULT_MAX_* quotas; allowlist: VAULT_ALLOWED_PUBKEYS; off) and
# the most days an archive is kept since its last write (empty: until deleted).
VAULT_PUBLIC_URL=http://localhost:8088
VAULT_NIP98=open
VAULT_ALLOWED_PUBKEYS=
VAULT_RETENTION_DAYS=

# Secondary relay (Marmot/MLS groups, Tor personas). Edit infra/secure-relay/config.toml relay_url to its public URL.
SECURE_RELAY_PORT=7000

# --profile push: opaque Web Push gateway (ADR 0010). Generate the VAPID key once and keep it stable:
#   node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();console.log(e.getPrivateKey('base64url'))"
# Add "notificationGateway": "<NOTIFY_PUBLIC_URL>" to infra/web/config.json to offer the control in the web.
NOTIFY_RELAYS=ws://localhost:3000=ws://relay:3000
NOTIFY_VAPID_PRIVATE_KEY=
NOTIFY_VAPID_SUBJECT=mailto:admin@localhost
NOTIFY_NSEC=
NOTIFY_PUBLIC_URL=http://localhost:8086
