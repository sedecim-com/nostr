# Stage values shared by deploy/k8s/scripts (same conventions as buzz-hermes-stack/k8s/values.env).
# Private ECR of the Sedecim account. Never Docker Hub / ghcr in stage or production.
ECR_REGISTRY=212568716371.dkr.ecr.us-east-1.amazonaws.com
AWS_REGION=us-east-1

# kops cluster sedecim-stage.k8s.local: the scripts refuse any kubectl context without this substring.
EXPECTED_CONTEXT_SUBSTR=sedecim-stage
NAMESPACE=acceso-nostr
OVERLAY=deploy/k8s/overlays/stage

# Fixed NodePort = port of the ALB target group (deploy/terraform var.node_port). 31800 is buzz-hermes.
NODE_PORT=31810

# Public hosts (first label rule in deploy/k8s/base/files/edge-nginx.conf), all under *.ai.acce.so.
PUBLIC_HOST=nostr-stage.ai.acce.so
PUBLIC_SCHEME=https

# AWS Secrets Manager: stack secrets (JSON key/value) and the managed-signer IAM user keys, both created by
# deploy/terraform (module acceso-nostr, env = stage).
SECRET_ID=k8s/stage/acceso-nostr
SIGNER_CREDENTIALS_SECRET_ID=acceso_nostr_managed_signer_stage_credentials
