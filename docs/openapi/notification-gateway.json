{
  "openapi": "3.1.0",
  "info": {
    "title": "notification-gateway",
    "version": "0.1.0",
    "description": "Notificaciones push opacas (ADR 0010): observa los relays que puede observar sin leer DMs.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8086",
      "description": "Stack de docker compose en local"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Salud del servicio.",
        "security": [],
        "responses": {
          "2XX": {
            "description": "Respuesta correcta (JSON salvo los blobs de Blossom)."
          },
          "4XX": {
            "description": "Petición rechazada: 400, 401, 403, 404, 409, 413 o 429 (con `Retry-After`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/vapid": {
      "get": {
        "operationId": "getV1Vapid",
        "summary": "Llave pública VAPID (`applicationServerKey`) para suscribirse.",
        "security": [],
        "responses": {
          "2XX": {
            "description": "Respuesta correcta (JSON salvo los blobs de Blossom)."
          },
          "4XX": {
            "description": "Petición rechazada: 400, 401, 403, 404, 409, 413 o 429 (con `Retry-After`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/relays": {
      "get": {
        "operationId": "getV1Relays",
        "summary": "Relays que el gateway puede observar sin leer DMs de nadie (OPS-06).",
        "security": [],
        "responses": {
          "2XX": {
            "description": "Respuesta correcta (JSON salvo los blobs de Blossom)."
          },
          "4XX": {
            "description": "Petición rechazada: 400, 401, 403, 404, 409, 413 o 429 (con `Retry-After`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/subscriptions": {
      "post": {
        "operationId": "postV1Subscriptions",
        "summary": "Registra una suscripción Web Push para las personas de quien firma.",
        "security": [
          {
            "nip98": []
          }
        ],
        "responses": {
          "2XX": {
            "description": "Respuesta correcta (JSON salvo los blobs de Blossom)."
          },
          "4XX": {
            "description": "Petición rechazada: 400, 401, 403, 404, 409, 413 o 429 (con `Retry-After`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteV1Subscriptions",
        "summary": "Borra una suscripción.",
        "security": [
          {
            "nip98": []
          }
        ],
        "responses": {
          "2XX": {
            "description": "Respuesta correcta (JSON salvo los blobs de Blossom)."
          },
          "4XX": {
            "description": "Petición rechazada: 400, 401, 403, 404, 409, 413 o 429 (con `Retry-After`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "securitySchemes": {
      "nip98": {
        "type": "http",
        "scheme": "Nostr",
        "description": "NIP-98: `Authorization: Nostr <evento kind 27235 en base64>`, firmado para esta URL y este método."
      }
    }
  }
}
