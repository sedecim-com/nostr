        "description": "Token de ID del login de Acceso (Cognito, ADR 0008)."
      },
      "deviceSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sesión de dispositivo del managed-signer (`sds_…`, FR024-03)."
      },
      "revocationToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de revocación (`MANAGED_SIGNER_REVOCATION_TOKENS`), solo para revocar dispositivos."
      }
    }
  }
}
