{
  "openapi": "3.1.0",
  "info": {
    "title": "blob-store",
    "version": "0.1.0",
    "description": "Servidor Blossom agnóstico al contenido para adjuntos cifrados en el cliente (BUD-01/02).",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8085",
      "description": "Stack de docker compose en local"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Salud del servicio.",
        "security": [],
        "responses": {
          "2XX": {
            "description": "Respuesta correcta (JSON salvo los blobs de Blossom)."
          },
          "4XX": {
            "description": "Petición rechazada: 400, 401, 403, 404, 409, 413 o 429 (con `Retry-After`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/upload": {
      "put": {
        "operationId": "putUpload",
        "summary": "Sube un blob (BUD-02); la autorización lleva su sha256 en `x`.",
        "security": [
          {
            "blossom": []
          }
        ],
        "responses": {
          "2XX": {
            "description": "Respuesta correcta (JSON salvo los blobs de Blossom)."
          },
          "4XX": {
            "description": "Petición rechazada: 400, 401, 403, 404, 409, 413 o 429 (con `Retry-After`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/{sha256}": {
      "get": {
        "operationId": "getBySha256",
        "summary": "Descarga un blob por su sha256 (BUD-01), con extensión opcional.",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [],
        "responses": {
          "2XX": {
            "description": "Respuesta correcta (JSON salvo los blobs de Blossom)."
          },
          "4XX": {
            "description": "Petición rechazada: 400, 401, 403, 404, 409, 413 o 429 (con `Retry-After`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "head": {
        "operationId": "headBySha256",
        "summary": "Si el blob existe, con su tamaño y tipo.",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [],
        "responses": {
          "2XX": {
            "description": "Respuesta correcta (JSON salvo los blobs de Blossom)."
          },
          "4XX": {
            "description": "Petición rechazada: 400, 401, 403, 404, 409, 413 o 429 (con `Retry-After`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteBySha256",
        "summary": "Borra un blob que subió quien firma (BUD-02 `delete`).",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "blossom": []
          }
        ],
        "responses": {
          "2XX": {
            "description": "Respuesta correcta (JSON salvo los blobs de Blossom)."
          },
          "4XX": {
            "description": "Petición rechazada: 400, 401, 403, 404, 409, 413 o 429 (con `Retry-After`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "securitySchemes": {
      "blossom": {
        "type": "http",
        "scheme": "Nostr",
        "description": "Blossom BUD-02: `Authorization: Nostr <evento kind 24242 en base64>` con `t` y `x` (sha256)."
      }
    }
  }
}
